# ---------------------------------------------------------------------------
# Copy to .env.local for local development.
# Never commit a file containing real values.
# ---------------------------------------------------------------------------

# Public: safe to expose to the browser. RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Used by the pg_cron → /api/cron/* endpoints.
CRON_SECRET=

# Email delivery (optional in development — a console provider is used when unset)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Customer Support

# Absolute URL used in confirmation and reset links
APP_BASE_URL=http://localhost:3000

# Debug | info | warn | error
LOG_LEVEL=info